# Shared passcode required to view the site. Set this in Vercel's
# Environment Variables (Project Settings -> Environment Variables) and
# locally in a .env file (not committed) for development.
PASSCODE=change-me

# Postgres connection. When a Neon database is attached to the Vercel
# project, these are added automatically — no need to set them by hand in
# Vercel. For local development, run `vercel env pull .env` to copy them
# down, or paste your own Neon connection string here.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
POSTGRES_URL=postgres://user:password@host/dbname?sslmode=require
